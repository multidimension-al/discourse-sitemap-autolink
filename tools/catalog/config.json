{
  "baseUrl": "https://www.gbfans.com",
  "sources": [
    { "sitemap": "/sitemaps/shop-products.xml", "type": "product", "maxBytes": 262144 },
    { "sitemap": "/sitemaps/shop-categories.xml", "type": "category", "maxBytes": 524288 },
    { "sitemap": "/sitemaps/wiki.xml", "type": "wiki", "maxBytes": 524288 }
  ],
  "typePriority": ["product", "category", "wiki"],
  "minAliasLength": 5,
  "minWikiTitleWords": 2,
  "excludeCommonSingleWords": true,
  "fetch": {
    "concurrency": 4,
    "delayMs": 60,
    "timeoutMs": 30000,
    "userAgent": "GBFansAutolinkCatalog/0.1 (catalog builder run by GBFans.com staff)"
  },
  "cacheDir": ".cache",
  "distDir": "dist",
  "overrides": "overrides.json"
}
